# Port and bind address for the Node service.
PORT=3000
HOST=0.0.0.0

# Storage — first match wins:
#   MYSQL_URL      -> MySQL 8; schema.mysql.sql applied idempotently at boot and seeded.
#   DATABASE_URL   -> PostgreSQL 16; schema.sql applied idempotently at boot and seeded.
#   neither        -> file-backed JSON store at DATA_FILE. No infrastructure needed.
# MYSQL_URL=mysql://user:password@host:3306/meltek
# DATABASE_URL=postgres://user:password@host:5432/meltek
# PGSSL=true

DATA_FILE=data/meltek.json

# pino level: trace | debug | info | warn | error
LOG_LEVEL=info

# ── Accounts ────────────────────────────────────────────────────────────────
# The built-in administrator is recreated at every startup if it is missing, so the works
# can always get back in. Set its password here; leave it unset and a strong one is
# generated and printed to the log once, at creation.
# MELTEK_ADMIN_NAME=Works Administrator
# MELTEK_ADMIN_EMAIL=admin@meltek.local
# MELTEK_ADMIN_PASSWORD=   # at least 12 characters, or a random one is generated

# Send session cookies only over https. Implied when NODE_ENV=production, and needed
# explicitly when TLS is terminated at a proxy and the app itself speaks http.
# SECURE_COOKIES=true

# Behind a proxy, so req.ip is the client rather than the proxy - the sign-in throttle
# depends on it. See the Express 'trust proxy' setting for accepted values.
# TRUST_PROXY=1
