{
  "name": "meltek",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "npm run build -w @meltek/engine && npm run build -w @meltek/schema && npm run build -w @meltek/web && npm run build -w @meltek/api",
    "test": "npm run test -w @meltek/engine",
    "dev": "npm run dev -w @meltek/api",
    "start": "node apps/api/dist/server.js",
    "seed": "node apps/api/dist/seed.js"
  }
}
